{
  "ConnectionStrings": { "DefaultConnection": "Host=localhost;Port=5432;Database=reponav;Username=reponav;Password=change-me" },
  "Jwt": { "Issuer": "RepoNavAI", "Audience": "RepoNavAI.Web", "SigningKey": "", "ExpirationMinutes": 60 },
  "Cors": { "AllowedOrigins": ["http://localhost:5173"] },
  "GitHub": { "AccessToken": "" },
  "OpenAI": { "ApiKey": "", "EmbeddingModel": "text-embedding-3-small", "EmbeddingDimensions": 512 },
  "Indexing": { "WorkerEnabled": true, "PollSeconds": 2, "LeaseMinutes": 5, "MaxAttempts": 3, "MaximumFiles": 5000, "MaximumFileBytes": 1048576, "MaximumSnapshotBytes": 52428800 },
