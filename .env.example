POSTGRES_DB=reponav
POSTGRES_USER=reponav
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional for public repositories; required for private repositories and higher GitHub API limits.
GITHUB_ACCESS_TOKEN=
# Required to generate semantic-search embeddings.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_CHAT_MAX_OUTPUT_TOKENS=1200
OPENAI_CHAT_MAX_CONTEXT_CHARACTERS=32000
REPOSITORY_CHAT_DAILY_LIMIT=100
